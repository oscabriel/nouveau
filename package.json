{
	"name": "nouveau",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.5.4",
			"typescript": "^7.0.2",
			"@types/node": "^26.4.0",
			"lucide-react": "^1.37.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"convex": "^1.45.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.5",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F @nouveau/backend --",
		"dev:setup": "turbo run dev:setup -F @nouveau/backend --",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"deploy": "cd packages/backend && CONVEX_DEPLOYMENT=prod:artful-chameleon-402 npx @convex-dev/static-hosting deploy --build-command \"bun run --filter web build\" --dist ../../apps/web/dist"
	},
	"dependencies": {
		"@nouveau/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nouveau/config": "workspace:*",
		"@types/node": "catalog:",
		"convex": "catalog:",
		"oxfmt": "latest",
		"oxlint": "latest",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"ultracite": "7.10.7"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@agentmail/convex@0.1.0": "patches/@agentmail%2Fconvex@0.1.0.patch"
	}
}
